# FinRisk Lab - Standalone Cloud & Container Deployment
# Single-container production build for Cloud Run, Hugging Face Spaces, Render, or Railway.
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY src ./src
COPY streamlit_app.py ./
COPY reports ./reports
COPY .streamlit ./.streamlit

# Cloud Run / Render injects PORT; default to 8501
ENV PORT=8501
EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:${PORT}/_stcore/health || exit 1

ENTRYPOINT ["sh", "-c", "streamlit run streamlit_app.py --server.port=${PORT} --server.address=0.0.0.0"]
